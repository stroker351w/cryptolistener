<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crypto News Hub</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f8f6; --card: #ffffff; --text: #142620; --muted: #5c6b63;
    --border: #dfe8e2; --accent: #1f6f4a; --tag-bg: #e6f2ec; --tag-text: #1f6f4a;
    --up: #1f9d55; --down: #d1453b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1512; --card: #16211c; --text: #e6efe9; --muted: #92a39a;
      --border: #253830; --accent: #4caf7d; --tag-bg: #1c332a; --tag-text: #7fd1a8;
      --up: #4caf7d; --down: #ff6b6b;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .ticker-wrap {
    background: var(--card); border-bottom: 1px solid var(--border);
    overflow: hidden; white-space: nowrap;
  }
  .ticker-track {
    display: inline-flex; width: max-content;
    animation: ticker-scroll 35s linear infinite;
  }
  .ticker-wrap:hover .ticker-track { animation-play-state: paused; }
  .ticker-item {
    display: inline-flex; align-items: baseline; gap: .4rem;
    padding: .55rem 1.5rem; font-size: .82rem; white-space: nowrap;
  }
  .ticker-item .rank { color: var(--muted); font-size: .72rem; }
  .ticker-item .sym { font-weight: 700; color: var(--text); }
  .ticker-item .px { color: var(--muted); }
  .ticker-item .chg.up { color: var(--up); font-weight: 600; }
  .ticker-item .chg.down { color: var(--down); font-weight: 600; }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; overflow-x: auto; }
  }
  header {
    padding: 2rem 1.25rem 1rem; max-width: 1120px; margin: 0 auto;
  }
  header h1 {
    margin: 0 0 .15rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em;
    color: var(--accent);
  }
  header p { margin: 0; color: var(--muted); font-size: .9rem; }
  header p + p { margin-top: .2rem; }
  main { max-width: 1120px; margin: 0 auto; padding: 0 1.25rem 3rem; }
  .columns {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1.75rem;
  }
  @media (max-width: 760px) {
    .columns { grid-template-columns: 1fr; }
  }
  section { margin-top: 1.75rem; }
  section h2 {
    font-size: 1rem; text-transform: uppercase; letter-spacing: .04em;
    color: var(--muted); margin: 0 0 .25rem; font-weight: 600;
  }
  .col-note { color: var(--muted); font-size: .78rem; margin: 0 0 .75rem; }
  .card {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: .9rem 1rem; margin-bottom: .6rem;
  }
  .card a.title {
    color: var(--text); text-decoration: none; font-weight: 600; font-size: .98rem;
  }
  .card a.title:hover { color: var(--accent); }
  .meta { display: flex; gap: .5rem; align-items: center; margin-top: .3rem; }
  .tag {
    background: var(--tag-bg); color: var(--tag-text); font-size: .72rem;
    padding: .1rem .5rem; border-radius: 100px; font-weight: 600;
  }
  .time { color: var(--muted); font-size: .78rem; }
  .flag { margin-right: .3rem; }
  .summary { color: var(--muted); font-size: .85rem; margin-top: .35rem; }
  .x-post { font-size: .88rem; }
  .x-post .stats { color: var(--muted); font-size: .78rem; }
  .empty-note {
    color: var(--muted); font-size: .85rem; border: 1px dashed var(--border);
    border-radius: 10px; padding: .9rem 1rem;
  }
  footer {
    max-width: 1120px; margin: 0 auto; padding: 1rem 1.25rem 2rem;
    color: var(--muted); font-size: .78rem; border-top: 1px solid var(--border);
  }
  footer a { color: var(--muted); }
</style>
</head>
<body>
{% if prices %}
<div class="ticker-wrap" role="marquee" aria-label="Top 10 cryptocurrencies by market cap">
  <div class="ticker-track">
    {% for p in prices + prices %}
    <span class="ticker-item">
      <span class="rank">#{{ p.market_cap_rank }}</span>
      <span class="sym">{{ p.symbol }}</span>
      <span class="px">{{ p.price_display }}</span>
      <span class="chg {{ 'up' if p.change_up else 'down' }}">{{ p.change_display }}</span>
    </span>
    {% endfor %}
  </div>
</div>
{% endif %}
<header>
  <h1>Crypto News Hub</h1>
  <p>Auto-aggregated crypto news{{ " + X posts" if x_enabled else "" }} &middot; refreshes automatically every hour &middot; last updated {{ generated_at }}</p>
  <p>🟢 = keyword match for relevance (custody, ETFs, regulation, institutional adoption) &mdash; heuristic, not verified impact</p>
</header>
<main>
  <div class="columns">
    <section>
      <h2>News &amp; Events ({{ event_articles|length }})</h2>
      <p class="col-note">Reported happenings &mdash; filings, rulings, launches, hacks, partnerships.</p>
      {% for a in event_articles %}
      <div class="card">
        <a class="title" href="{{ a.link }}" target="_blank" rel="noopener">{% if a.relevant %}<span class="flag" title="Keyword match: may be relevant (custody, ETFs, or crypto regulation) -- heuristic, not verified impact">🟢</span>{% endif %}{{ a.title }}</a>
        <div class="meta">
          <span class="tag">{{ a.source }}</span>
          <span class="time">{{ a.published_display }}</span>
        </div>
        {% if a.summary %}<div class="summary">{{ a.summary }}</div>{% endif %}
      </div>
      {% else %}
      <div class="empty-note">No event articles this run.</div>
      {% endfor %}
    </section>

    <section>
      <h2>Market Sentiment ({{ sentiment_articles|length }})</h2>
      <p class="col-note">Predictions, price targets, and bullish/bearish takes &mdash; heuristic split, not verified.</p>
      {% for a in sentiment_articles %}
      <div class="card">
        <a class="title" href="{{ a.link }}" target="_blank" rel="noopener">{% if a.relevant %}<span class="flag" title="Keyword match: may be relevant (custody, ETFs, or crypto regulation) -- heuristic, not verified impact">🟢</span>{% endif %}{{ a.title }}</a>
        <div class="meta">
          <span class="tag">{{ a.source }}</span>
          <span class="time">{{ a.published_display }}</span>
        </div>
        {% if a.summary %}<div class="summary">{{ a.summary }}</div>{% endif %}
      </div>
      {% else %}
      <div class="empty-note">No sentiment articles this run.</div>
      {% endfor %}
    </section>
  </div>

  <section>
    <h2>Trending on X</h2>
    {% if not x_enabled %}
    <div class="empty-note">
      X integration isn't configured (needs optional cookie-based auth &mdash; see README).
      This section will populate automatically once it is.
    </div>
    {% elif x_posts|length == 0 %}
    <div class="empty-note">X integration is configured but returned no posts this run (likely an expired session or an X API change &mdash; see README's maintenance note).</div>
    {% else %}
    {% for p in x_posts %}
    <div class="card x-post">
      <a class="title" href="{{ p.url }}" target="_blank" rel="noopener">@{{ p.author }}</a>
      <div>{{ p.text }}</div>
      <div class="stats">&hearts; {{ p.likes }} &middot; &#8635; {{ p.retweets }} &middot; matched "{{ p.keyword }}"</div>
    </div>
    {% endfor %}
    {% endif %}
  </section>
</main>
<footer>
  Generated automatically by GitHub Actions &middot;
  <a href="https://github.com/stroker351w/cryptolistener" target="_blank" rel="noopener">source</a>
</footer>
</body>
</html>
