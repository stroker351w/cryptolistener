<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Crypto News Hub</title>
<meta name="description" content="Auto-updating crypto news aggregator: hourly RSS pull across 12 sources, split into News &amp; Events vs. Market Sentiment, flagged for regulatory/legal and institutional-adoption relevance, with a live top-10 price ticker.">
<meta property="og:title" content="Crypto News Hub">
<meta property="og:description" content="Auto-updating crypto news aggregator, refreshed hourly &mdash; News &amp; Events, Market Sentiment, and a top-10 price ticker.">
<meta property="og:type" content="website">
<meta property="og:url" content="https://stroker351w.github.io/cryptolistener/">
<link rel="icon" href="data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48dGV4dCB5PSIuODVlbSIgZm9udC1zaXplPSI4NSI+8J+qmTwvdGV4dD48L3N2Zz4=">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #f5f8f6; --card: #ffffff; --text: #142620; --muted: #5c6b63;
    --border: #dfe8e2; --accent: #1f6f4a; --tag-bg: #e6f2ec; --tag-text: #1f6f4a;
    --up: #1f9d55; --down: #d1453b;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1512; --card: #16211c; --text: #e6efe9; --muted: #92a39a;
      --border: #253830; --accent: #4caf7d; --tag-bg: #1c332a; --tag-text: #7fd1a8;
      --up: #4caf7d; --down: #ff6b6b;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font: 15px/1.5 "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .ticker-wrap {
    background: var(--card); border-bottom: 1px solid var(--border);
    overflow: hidden; white-space: nowrap;
  }
  .ticker-track {
    display: inline-flex; width: max-content;
    animation: ticker-scroll 35s linear infinite;
  }
  .ticker-wrap:hover .ticker-track { animation-play-state: paused; }
  .ticker-item {
    display: inline-flex; align-items: baseline; gap: .4rem;
    padding: .55rem 1.5rem; font-size: .82rem; white-space: nowrap;
    border: none; background: none; font-family: inherit; color: inherit;
    cursor: pointer; border-radius: 6px;
  }
  .ticker-item:hover, .ticker-item:focus-visible { background: var(--tag-bg); }
  .ticker-item:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .ticker-item.active-coin { background: var(--tag-bg); box-shadow: inset 0 0 0 1px var(--tag-text); }
  .ticker-item .rank { color: var(--muted); font-size: .72rem; }
  .ticker-item .sym { font-weight: 700; color: var(--text); }
  .ticker-item .px { color: var(--muted); }
  .ticker-item .chg.up { color: var(--up); font-weight: 600; }
  .ticker-item .chg.down { color: var(--down); font-weight: 600; }
  @keyframes ticker-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; overflow-x: auto; }
  }
  header {
    padding: 2rem 1.25rem 1rem; max-width: 1120px; margin: 0 auto;
  }
  header h1 {
    margin: 0 0 .15rem; font-size: 1.5rem; font-weight: 700; letter-spacing: -.01em;
    color: var(--accent);
  }
  header p { margin: 0; color: var(--muted); font-size: .9rem; }
  header p + p { margin-top: .2rem; }
  main { max-width: 1120px; margin: 0 auto; padding: 0 1.25rem 3rem; }
  .filter-bar {
    margin: 1.25rem 0 0; display: flex; flex-wrap: wrap; gap: .6rem; align-items: center;
  }
  .filter-bar input[type="search"] {
    flex: 1 1 220px; padding: .5rem .75rem; border-radius: 8px; border: 1px solid var(--border);
    background: var(--card); color: var(--text); font: inherit; font-size: .85rem;
  }
  .filter-bar input[type="search"]:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .filter-bar input[type="search"]::-webkit-search-cancel-button { filter: opacity(.6); }
  .source-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
  .chip {
    font: inherit; font-size: .76rem; font-weight: 600; padding: .3rem .65rem; border-radius: 100px;
    border: 1px solid var(--border); background: var(--card); color: var(--muted); cursor: pointer;
    opacity: .55;
  }
  .chip.active { color: var(--tag-text); background: var(--tag-bg); border-color: var(--tag-text); opacity: 1; }
  .chip.reset { color: var(--text); opacity: 1; background: transparent; border-style: dashed; }
  .chip.coin-filter-chip { color: var(--tag-text); background: var(--tag-bg); border-color: var(--tag-text); opacity: 1; }
  .columns {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 1.75rem; margin-top: 1.25rem;
  }
  @media (max-width: 760px) {
    .columns { grid-template-columns: 1fr; }
  }
  section { margin-top: 1.75rem; }
  section h2 {
    font-size: 1rem; text-transform: uppercase; letter-spacing: .04em;
    color: var(--muted); margin: 0 0 .25rem; font-weight: 600;
  }
  .col-note { color: var(--muted); font-size: .78rem; margin: 0 0 .75rem; }
  .card {
    background: var(--card); border: 1px solid var(--border); border-radius: 10px;
    padding: .9rem 1rem; margin-bottom: .6rem;
  }
  .card a.title {
    color: var(--text); text-decoration: none; font-weight: 600; font-size: .98rem;
  }
  .card a.title:hover { color: var(--accent); }
  .meta { display: flex; gap: .5rem; align-items: center; margin-top: .3rem; }
  .tag {
    background: var(--tag-bg); color: var(--tag-text); font-size: .72rem;
    padding: .1rem .5rem; border-radius: 100px; font-weight: 600;
  }
  .time { color: var(--muted); font-size: .78rem; }
  .flag { margin-right: .3rem; }
  .summary { color: var(--muted); font-size: .85rem; margin-top: .35rem; }
  .x-post { font-size: .88rem; }
  .x-post .stats { color: var(--muted); font-size: .78rem; }
  .empty-note {
    color: var(--muted); font-size: .85rem; border: 1px dashed var(--border);
    border-radius: 10px; padding: .9rem 1rem;
  }
  footer {
    max-width: 1120px; margin: 0 auto; padding: 1rem 1.25rem 2rem;
    color: var(--muted); font-size: .78rem; border-top: 1px solid var(--border);
  }
  footer a { color: var(--muted); }
</style>
</head>
<body>
{% if prices %}
<div class="ticker-wrap" role="marquee" aria-label="Top 10 cryptocurrencies by market cap">
  <div class="ticker-track">
    {% for p in prices + prices %}
    <button type="button" class="ticker-item" data-symbol="{{ p.symbol }}" aria-pressed="false" aria-label="Filter articles mentioning {{ p.name }}">
      <span class="rank">#{{ p.market_cap_rank }}</span>
      <span class="sym">{{ p.symbol }}</span>
      <span class="px">{{ p.price_display }}</span>
      <span class="chg {{ 'up' if p.change_up else 'down' }}">{{ p.change_display }}</span>
    </button>
    {% endfor %}
  </div>
</div>
{% endif %}
<header>
  <h1>Crypto News Hub</h1>
  <p>Auto-aggregated crypto news{{ " + X posts" if x_enabled else "" }} &middot; refreshes automatically every hour &middot; last updated {{ generated_at }}{% if prices_age_display %} &middot; prices as of {{ prices_age_display }}{% endif %}</p>
  <p>⚖️ = regulatory/legal keyword match &middot; 🏦 = institutional-adoption keyword match &mdash; both heuristic, not verified impact</p>
</header>
<main>
  <div class="filter-bar">
    <input type="search" id="search-input" placeholder="Search headlines &amp; summaries&hellip;" aria-label="Search articles">
    <div class="source-chips" id="source-chips">
      <button type="button" class="chip reset" data-action="reset">Reset</button>
      {% for s in sources %}
      <button type="button" class="chip active" data-source="{{ s }}" aria-pressed="true">{{ s }}</button>
      {% endfor %}
      <button type="button" class="chip coin-filter-chip" id="coin-filter-chip" hidden></button>
    </div>
  </div>
  <div class="columns">
    <section>
      <h2>News &amp; Events ({{ event_articles|length }})</h2>
      <p class="col-note">Reported happenings &mdash; filings, rulings, launches, hacks, partnerships.</p>
      {% for a in event_articles %}
      <div class="card" data-source="{{ a.source }}" data-coins="{{ a.coins|join(' ') }}">
        <a class="title" href="{{ a.link }}" target="_blank" rel="noopener">{% if a.regulatory %}<span class="flag" title="Keyword match: regulatory/legal (SEC, CFTC, courts, legislation) -- heuristic, not verified impact">⚖️</span>{% endif %}{% if a.institutional %}<span class="flag" title="Keyword match: institutional adoption/demand (asset managers, corporate treasuries, retirement money) -- heuristic, not verified impact">🏦</span>{% endif %}{{ a.title }}</a>
        <div class="meta">
          <span class="tag">{{ a.source }}</span>
          <span class="time">{{ a.published_display }}</span>
        </div>
        {% if a.summary %}<div class="summary">{{ a.summary }}</div>{% endif %}
      </div>
      {% else %}
      <div class="empty-note">No event articles this run.</div>
      {% endfor %}
    </section>

    <section>
      <h2>Market Sentiment ({{ sentiment_articles|length }})</h2>
      <p class="col-note">Predictions, price targets, and bullish/bearish takes &mdash; heuristic split, not verified.</p>
      {% for a in sentiment_articles %}
      <div class="card" data-source="{{ a.source }}" data-coins="{{ a.coins|join(' ') }}">
        <a class="title" href="{{ a.link }}" target="_blank" rel="noopener">{% if a.regulatory %}<span class="flag" title="Keyword match: regulatory/legal (SEC, CFTC, courts, legislation) -- heuristic, not verified impact">⚖️</span>{% endif %}{% if a.institutional %}<span class="flag" title="Keyword match: institutional adoption/demand (asset managers, corporate treasuries, retirement money) -- heuristic, not verified impact">🏦</span>{% endif %}{{ a.title }}</a>
        <div class="meta">
          <span class="tag">{{ a.source }}</span>
          <span class="time">{{ a.published_display }}</span>
        </div>
        {% if a.summary %}<div class="summary">{{ a.summary }}</div>{% endif %}
      </div>
      {% else %}
      <div class="empty-note">No sentiment articles this run.</div>
      {% endfor %}
    </section>
  </div>

  {% if x_enabled %}
  <section>
    <h2>Trending on X</h2>
    {% if x_posts|length == 0 %}
    <div class="empty-note">X integration is configured but returned no posts this run (likely an expired session or an X API change &mdash; see README's maintenance note).</div>
    {% else %}
    {% for p in x_posts %}
    <div class="card x-post">
      <a class="title" href="{{ p.url }}" target="_blank" rel="noopener">@{{ p.author }}</a>
      <div>{{ p.text }}</div>
      <div class="stats">&hearts; {{ p.likes }} &middot; &#8635; {{ p.retweets }} &middot; matched "{{ p.keyword }}"</div>
    </div>
    {% endfor %}
    {% endif %}
  </section>
  {% endif %}
</main>
<script>
(function () {
  var chips = Array.prototype.slice.call(document.querySelectorAll('#source-chips .chip'));
  var sourceChips = chips.filter(function (c) { return c.dataset.source; });
  var resetChip = document.querySelector('#source-chips .chip[data-action="reset"]');
  var searchInput = document.getElementById('search-input');
  var sections = Array.prototype.slice.call(document.querySelectorAll('main .columns section'));
  var tickerButtons = Array.prototype.slice.call(document.querySelectorAll('.ticker-item'));
  var coinFilterChip = document.getElementById('coin-filter-chip');
  var activeCoin = null;

  function activeSources() {
    var set = {};
    sourceChips.forEach(function (c) {
      if (c.classList.contains('active')) set[c.dataset.source] = true;
    });
    return set;
  }

  function applyFilters() {
    var active = activeSources();
    var query = searchInput.value.trim().toLowerCase();
    sections.forEach(function (section) {
      var cards = Array.prototype.slice.call(section.querySelectorAll('.card'));
      var visible = 0;
      cards.forEach(function (card) {
        var matchesSource = !!active[card.dataset.source];
        var matchesQuery = !query || card.textContent.toLowerCase().indexOf(query) !== -1;
        var coins = (card.dataset.coins || '').split(' ').filter(Boolean);
        var matchesCoin = !activeCoin || coins.indexOf(activeCoin) !== -1;
        var show = matchesSource && matchesQuery && matchesCoin;
        card.hidden = !show;
        if (show) visible++;
      });
      var note = section.querySelector('.no-match-note');
      if (cards.length === 0) return; // "No X articles this run" case -- leave as-is
      if (!note) {
        note = document.createElement('div');
        note.className = 'empty-note no-match-note';
        note.textContent = 'No articles match the current filters.';
        section.appendChild(note);
      }
      note.hidden = visible !== 0;
    });
  }

  function setActiveCoin(symbol) {
    activeCoin = symbol;
    tickerButtons.forEach(function (btn) {
      var isActive = !!symbol && btn.dataset.symbol === symbol;
      btn.classList.toggle('active-coin', isActive);
      btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
    if (coinFilterChip) {
      if (symbol) {
        coinFilterChip.hidden = false;
        coinFilterChip.textContent = 'Coin: ' + symbol + ' ✕';
      } else {
        coinFilterChip.hidden = true;
        coinFilterChip.textContent = '';
      }
    }
    applyFilters();
  }

  sourceChips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var nowActive = chip.classList.toggle('active');
      chip.setAttribute('aria-pressed', nowActive ? 'true' : 'false');
      applyFilters();
    });
  });
  if (resetChip) {
    resetChip.addEventListener('click', function () {
      sourceChips.forEach(function (c) {
        c.classList.add('active');
        c.setAttribute('aria-pressed', 'true');
      });
      searchInput.value = '';
      setActiveCoin(null);
    });
  }
  tickerButtons.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var symbol = btn.dataset.symbol;
      setActiveCoin(activeCoin === symbol ? null : symbol);
    });
  });
  if (coinFilterChip) {
    coinFilterChip.addEventListener('click', function () { setActiveCoin(null); });
  }
  searchInput.addEventListener('input', applyFilters);
})();
</script>
<footer>
  Generated automatically by GitHub Actions &middot;
  <a href="https://github.com/stroker351w/cryptolistener" target="_blank" rel="noopener">source</a>
</footer>
</body>
</html>
